{
  "manifest_version": 3,
  "name": "SupriAI",
  "version": "2.0.0",
  "description": "AI-Powered Browsing Intelligence — Track habits, predict productivity, and get ML-driven insights from your Chrome history",

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "windows",
    "activeTab",
    "scripting",
    "history",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-enhanced.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": [
      "config/keys.js",
      "services/gemini.js",
      "services/database.js",
      "services/databaseQueryHelper.js",
      "config.js",
      "lib/purify.min.js",
      "services/curationService.js",
      "services/backendAPI.js",
      "components/curationWorkflow.js",
      "styles/curation.css",
      "styles/fonts.css",
      "fonts/GoogleSans-Regular.woff",
      "fonts/GoogleSans-Medium.woff",
      "fonts/GoogleSans-Bold.woff"
    ],
    "matches": ["<all_urls>"]
  }]
} 