{
  "name": "supriai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n VITE,EXPRESS -c blue,green \"vite\" \"cd server && node server.js\"",
    "dev:full": "concurrently -n VITE,EXPRESS,FLASK -c blue,green,magenta \"vite\" \"cd server && node server.js\" \"cd server && python app.py\"",
    "dev:frontend": "vite",
    "dev:backend": "cd server && node server.js",
    "dev:python": "cd server && python app.py",
    "install:all": "npm install && cd server && npm install",
    "setup:python": "cd server && python -m pip install -r requirements.txt",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "python": "cd server && python app.py"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
