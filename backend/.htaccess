RewriteEngine On
RewriteBase /SupriAI/backend/

# Handle CORS Preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# API Routing
RewriteRule ^api/health$ api/health.php [L]
RewriteRule ^api/history$ api/history.php [L]
RewriteRule ^api/analytics/summary$ api/analytics_summary.php [L]
RewriteRule ^api/analytics/time-distribution$ api/time_distribution.php [L]

RewriteRule ^api/bookmarks$ api/bookmarks.php [L]
RewriteRule ^api/bookmarks/([0-9]+)$ api/bookmarks.php?id=$1 [L]

RewriteRule ^api/notes$ api/notes.php [L]
RewriteRule ^api/notes/([0-9]+)$ api/notes.php?id=$1 [L]

RewriteRule ^api/goals$ api/goals.php [L]
RewriteRule ^api/goals/([0-9]+)$ api/goals.php?id=$1 [L]

RewriteRule ^api/insights$ api/insights.php [L]
