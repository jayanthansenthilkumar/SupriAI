{
  "manifest_version": 3,
  "name": "SupriAI",
  "version": "2.0.0",
  "description": "AI-Powered Browsing Intelligence - Track habits, predict productivity, and get ML-driven insights from your Chrome history",

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "windows",
    "activeTab",
    "scripting",
    "history",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "assets/scripts/background-enhanced.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": [
      "assets/config/keys.js",
      "assets/scripts/script.js",
      "assets/scripts/services/database.js",
      "assets/scripts/lib/purify.min.js",
      "assets/styles/styles.css",
      "assets/fonts/GoogleSans-Regular.woff",
      "assets/fonts/GoogleSans-Medium.woff",
      "assets/fonts/GoogleSans-Bold.woff"
    ],
    "matches": ["<all_urls>"]
  }]
}
